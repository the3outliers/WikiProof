# GEMINI_API_KEY: Optional fallback for Gemini AI API calls via google-genai SDK.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL_SLUG="gemini-4-hydrogen"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Hostinger AI Router (OpenAI-compatible primary LLM endpoint)
HOSTINGER_AI_KEY="sk-hstgr-YOUR_KEY_HERE"
HOSTINGER_BASE_URL="https://router.hostinger.com/v1"
HOSTINGER_MODEL_SLUG="openai/gpt-4o-mini"

# Wikimedia API & EventStreams Identification
WIKI_USER_AGENT="WikiProof-Junction2026/1.0 (https://wikiproof.live; team@wikiproof.live)"
WIKI_STREAM_WIKIS="enwiki,fiwiki,dewiki,ruwiki"

# Forensic Risk Thresholds (0-100)
RISK_THRESHOLD_DEFAULT=50
RISK_THRESHOLD_UNCERTAIN=30
RISK_THRESHOLD_SUSPICIOUS=60
LLM_AUTO_ANALYZE_THRESHOLD=30
CROSS_WIKI_WINDOW_MINUTES=60

# Storage & Server Configuration
DB_PATH="data/wikiproof.db"
BENCHMARK_RESULTS_PATH="data/benchmark_results.json"
STREAM_ENABLED="true"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
LOG_LEVEL="INFO"

# Production Reverse Proxy (Caddy): set to your domain (e.g. wikiproof.live) for automatic HTTPS, or leave as :80
WIKIPROOF_DOMAIN=":80"
